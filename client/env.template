# DevDecks Client Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# API CONFIGURATION
# ===========================================

# Backend API URL
# For local development:
REACT_APP_API_URL=http://localhost:5001/api

# For production (Railway):
# REACT_APP_API_URL=https://your-railway-app.up.railway.app/api

# ===========================================
# APP CONFIGURATION
# ===========================================

# Application Name
REACT_APP_APP_NAME=DevDecks

# Application Version
REACT_APP_VERSION=1.0.0

# ===========================================
# FEATURE FLAGS (AI features)
# ===========================================
# CRA inlines these into the JS bundle at BUILD time — changing one requires a
# rebuild (or restarting `npm start` in dev), not just a page refresh. This only
# hides the UI; the matching API route is gated independently by the server-side
# FEATURE_* vars in server/env.template, which is what actually stops the request.
# Unset or anything other than the literal string "false" means enabled.

REACT_APP_FEATURE_CHAT=true
REACT_APP_FEATURE_AI_REWRITE=true
REACT_APP_FEATURE_KNOWLEDGE_GRAPH=true

